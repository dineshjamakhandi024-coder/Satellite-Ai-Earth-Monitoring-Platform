# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# IDEs & Editor configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Dynamic/Generated Uploads & Reports in Backend (preserve folders via .gitkeep)
Backend of satelite platform/uploads/*
!Backend of satelite platform/uploads/.gitkeep
Backend of satelite platform/reports/*
!Backend of satelite platform/reports/.gitkeep

# Databases & SQLite files
*.db
*.sqlite3
*.db-journal

# Logs & Temporary debug files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

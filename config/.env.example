# ============================================================
# SATELLITE AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and adjust configuration as needed
# ============================================================

# Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=True
API_TITLE="Satellite AI - Earth Observation API"
API_VERSION="2.0.0"

# CORS Configuration (comma-separated origins or * for all)
CORS_ALLOW_ORIGINS=*

# Mobile Server Configuration
MOBILE_SERVER_PORT=5500

# Database Configuration
DB_FILENAME=satellite_ai.db

# Storage Directories (Relative to Backend directory)
UPLOAD_DIRECTORY=uploads
REPORT_DIRECTORY=reports

# Security / Session (Future JWT expansion)
SECRET_KEY=satellite_ai_super_secret_aerospace_key_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
